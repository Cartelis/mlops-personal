.venv/
.venv-bootstrap/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# raw data is tracked by DVC (dataset.csv.dvc is committed instead of the bytes)
data/raw/*.csv
# pipeline outputs are restored from the DVC cache
data/processed/
models/*.pkl
models/*.onnx

# MLflow server state (metadata DB + artifact store)
mlruns/
mlflow.db
mlartifacts/
multirun/
outputs/

# DVC internals; .dvc/config is NOT ignored - the remote configuration lives in Git
.dvc/cache/
.dvc/tmp/

# kept in Git on purpose: .dvc/config, dvc.lock, metrics.json, models/run_id.txt

.env
*.log
# week 9 lab: generated files and the LLM venv
.lab9/
.venv-llm/
.venv-airflow/
models/tune_result.json
models/register_result.json
approvals/production.flag
