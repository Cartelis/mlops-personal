# The builder and runtime inherit the same patched Python and OS.
FROM python:3.12-slim-trixie AS base
# Install available OS security fixes; scan the resulting image before publishing.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

FROM base AS builder
WORKDIR /build
COPY requirements-cpu.txt constraints-week3.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-compile -r requirements-cpu.txt

FROM base AS runtime
ENV PATH="/opt/venv/bin:$PATH" \
    MODEL_PATH=/app/models/model.pkl \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src/serve.py ./src/serve.py
COPY observability/ ./observability/
COPY security/ ./security/
COPY models/model.pkl ./models/model.pkl
RUN useradd --create-home --uid 1000 mluser \
    && mkdir -p /app/docs && chown mluser:mluser /app/docs
USER mluser
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=2)"
CMD ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
