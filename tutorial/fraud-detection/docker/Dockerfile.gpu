# Linux amd64 only. Requires NVIDIA driver + Container Toolkit at runtime.
# The official image supplies a matched PyTorch / CUDA stack; Week 8's
# requirements-gpu.txt remains separate from this Week 3 infrastructure demo.
FROM pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime@sha256:b85566342b86d13a67712e9315d40cdc2dad7f8d86df1aff3831f80835edbcca

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# Runtime inference needs no Linux/Python C development headers.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get purge -y linux-libc-dev \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 mluser \
    && useradd --uid 10001 --gid 10001 --create-home mluser
# Patch the image's existing pip-installed stack. apt restores Ubuntu's
# PEP 668 marker; this exception is confined to the disposable container image.
RUN python -m pip install --break-system-packages --no-cache-dir --no-compile --upgrade \
    pillow==12.3.0 urllib3==2.7.0 \
    wheel==0.46.2 setuptools==84.0.0
COPY --chown=10001:10001 src/ ./src/
USER 10001:10001

EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=3 \
  CMD ["python", "-c", "import json, urllib.request; r = json.load(urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=4)); assert r['status'] == 'ok' and r['backend'] == 'cuda'"]
CMD ["python", "src/serve_gpu.py"]
