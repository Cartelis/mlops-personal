FROM python:3.12-slim-trixie
# Install available OS security fixes; scan the resulting image before publishing.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
ENV MODEL_PATH=/app/models/model.onnx \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements-onnx.txt constraints-week3.txt ./
RUN python -m pip install --no-cache-dir --no-compile -r requirements-onnx.txt
COPY models/model.onnx ./models/model.onnx
COPY src/serve_onnx.py ./src/serve_onnx.py
COPY security/ ./security/
RUN useradd --create-home --uid 1000 mluser
USER mluser
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=2)"
CMD ["uvicorn", "src.serve_onnx:app", "--host", "0.0.0.0", "--port", "8080"]
